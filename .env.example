# Payment integration stays disabled until an eligible merchant account and keys are configured.
PAYMENT_PROVIDER=disabled
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
DATABASE_URL=
EMAIL_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public URL for a secure AI chat backend. Never put an AI API key here.
NEXT_PUBLIC_CHATBOT_ENDPOINT=
# Server-side variables: configure these in Vercel, never in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
CHAT_ALLOWED_ORIGIN=https://keroo22.github.io
